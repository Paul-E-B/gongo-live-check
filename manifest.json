{
  "manifest_version": 3,
  "name": "Gongo Live Check",
  "version": "1.0",
  "description": "Shows whether GreatSphynx is live on gongo.tv. Click the icon to open the stream.",
  "permissions": ["alarms"],
  "host_permissions": ["https://api.angelthump.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Gongo - checking...",
    "default_icon": {
      "16": "icons/off16.png",
      "32": "icons/off32.png",
      "48": "icons/off48.png",
      "128": "icons/off128.png"
    }
  },
  "icons": {
    "16": "icons/off16.png",
    "32": "icons/off32.png",
    "48": "icons/off48.png",
    "128": "icons/off128.png"
  }
}
